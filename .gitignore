# =============================================================================
# Google Cloud SDK (installer archive + extracted directory)
# =============================================================================
google-cloud-cli-*.tar.gz
google-cloud-sdk/

# =============================================================================
# OS固有
# =============================================================================
.DS_Store
**/.DS_Store

# =============================================================================
# 機密情報・認証
# =============================================================================
.aws/
.gnupg/
.openai/
.ssh/id_*
.ssh/*.pem
*.key
*.pem
.env
.env.*
credentials.json
*credentials*

# =============================================================================
# キャッシュ・自動生成
# =============================================================================
node_modules/
package.json
package-lock.json

# opencode statusline plugin is vendored for dotfiles-managed config; keep npm manifests tracked.
!third_party/opencode/opencode-statusline/package.json
!third_party/opencode/opencode-statusline/package-lock.json

# textlint bundle for the japanese-tech-writing skill is built by nix from these manifests.
!.config/nix/pkgs/textlint-ja/package.json
!.config/nix/pkgs/textlint-ja/package-lock.json

.mypy_cache/

# Python (rye/uv) - 実行環境
.rye/shims/
.rye/uv/
.rye/py/

# =============================================================================
# ~/.config (allowlist)
# =============================================================================
# ~/.config はこのリポジトリの .config への symlink なので、GUI アプリの設定や
# キャッシュ (chromium, Slack, dconf, gtk-3.0, ...) と home-manager が生成する
# symlink (git, tmux, systemd, environment.d, ...) が作業ツリーに落ちてくる。
# 管理対象のディレクトリだけを許可し、それ以外は無視する。
# 新しいツールの設定を管理するときは !.config/<name>/ を足す。
# gcloud, gh, github-copilot, zed は認証トークンを含むので許可しない。
.config/*
!.config/aerospace/
!.config/cmux/
!.config/ghostty/
!.config/herdr/
!.config/kanata/
!.config/karabiner/
!.config/marimo/
!.config/mutagen/
!.config/nix/
!.config/nvim/
!.config/omniwm/
!.config/opencode/
!.config/wezterm/
!.config/yazi/

# =============================================================================
# WezTerm (マシンローカル設定)
# =============================================================================
.config/wezterm/local.lua

# =============================================================================
# Neovim
# =============================================================================
.config/nvim/archive/
.config/nvim/node_modules/
.config/nvim/plugin/packer_compiled.lua

# =============================================================================
# Karabiner-Elements (自動生成)
# =============================================================================
.config/karabiner/assets/
.config/karabiner/automatic_backups/

# =============================================================================
# Herdr (実行時ログ・ソケット・セッション状態を除外、config.tomlのみ管理)
# =============================================================================
.config/herdr/*.log
.config/herdr/*.log.*
.config/herdr/*.sock
.config/herdr/session.json
.config/herdr/session-history.json
.config/herdr/release-notes.json
.config/herdr/sessions/
.config/herdr/.plugins.lock

# =============================================================================
# Nix/Home Manager
# =============================================================================
result
.config/nix/nix.conf
.config/nix/home-manager/.claude/
.config/nix/home-manager/profiles/options-override.nix

# home-manager が生成する symlink。実体は /nix/store で switch のたびにハッシュが
# 変わるため、追跡すると永久に dirty になる。他の生成物は allowlist の外なので
# ここに書くのは許可済みディレクトリに落ちるものだけ。定義元は modules/mutagen.nix。
.config/mutagen/mutagen.yml
.config/nix/.claude/settings.local.json

# =============================================================================
# Claude Code (allowlist)
# =============================================================================
# ~/.claude is a symlink to this repo's .claude, so everything Claude Code writes at
# runtime (sessions, caches, feedback drafts, daemon state, ...) lands in the work tree.
# This repo is public: allow only config shared across machines and ignore the rest.
# To manage a new file, add !.claude/<name>.
.claude/*
!.claude/AGENTS.md
!.claude/CLAUDE.md
!.claude/hooks/
!.claude/output-styles/
!.claude/plugins/
.claude/plugins/*
!.claude/plugins/config.json
!.claude/runcat-statusline.py
!.claude/settings.json
!.claude/skills/
# claude.ai account sync (dir name is <org_id>_<user_id>); machine/account specific.
.claude/skills/synced/
!.claude/statusline.sh

**/settings.local.json
.tmp
.bonsai/
