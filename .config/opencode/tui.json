{
  "$schema": "https://opencode.ai/tui.json",

  // 誤爆を減らすため、グローバルなキーは意図的に残したものだけにしてある。
  // 残す基準は Claude Code で使っている操作。それ以外のグローバルは "none"。
  // 入力欄・ダイアログ・補完・diff ビューアのキーは、そのコンテキストが開いている
  // 間しか効かないので誤爆しない。既定のまま残してある。
  //
  // 消したコマンドは <leader>p のコマンドパレットから届く。
  // 現在有効なキーは ctrl+alt+k の which-key で確認できる。
  "keybinds": {

    // leader
    "leader": "ctrl+x",   // キーチェーンの起点

    // アプリ全体
    "app_exit": "<leader>q",   // 明示的な終了。ctrl+c と ctrl+d は外した
    "app_debug": "none",
    "app_console": "none",
    "app_heap_snapshot": "none",
    "app_toggle_animations": "none",
    "app_toggle_file_context": "none",
    "app_toggle_diffwrap": "none",
    "app_toggle_paste_summary": "none",
    "app_toggle_session_directory_filter": "none",

    // コマンドとヘルプ
    "command_list": "<leader>p",   // コマンドパレット。ctrl+p を上移動に譲った
    "help_show": "<leader>?",   // ショートカット一覧。既定は未割り当てだった
    "docs_open": "none",

    // diff ビューア (ビューア内でのみ有効)
    "diff_open": "none",
    "diff_close": "escape,q",
    "diff_toggle": "enter,space",
    "diff_expand": "right",
    "diff_expand_all": "E",
    "diff_collapse": "left",
    "diff_switch_focus": "tab",
    "diff_next_hunk": "]",
    "diff_previous_hunk": "[",
    "diff_next_file": "n",
    "diff_previous_file": "p",
    "diff_toggle_file_tree": "b",
    "diff_single_patch": "s",
    "diff_switch_source": "d",
    "diff_toggle_view": "v",
    "diff_help": "?",

    // エディタとテーマ
    "editor_open": "ctrl+d",   // 外部エディタ。ctrl+d を空けてここに割り当てた
    "theme_list": "none",   // 既定: "<leader>t"
    "theme_switch_mode": "none",
    "theme_mode_lock": "none",

    // UI
    "sidebar_toggle": "none",   // 既定: "<leader>b"
    "scrollbar_toggle": "none",
    "status_view": "none",   // 既定: "<leader>s"
    "debug_view": "none",

    // セッション
    "session_export": "none",   // 既定: "<leader>x"
    "session_copy": "none",
    "session_move": "none",
    "session_new": "none",   // 既定: "<leader>n"
    "session_list": "none",   // 既定: "<leader>l"
    "session_timeline": "none",   // 既定: "<leader>g"
    "session_fork": "none",
    "session_rename": "none",   // 既定: "ctrl+r"
    "session_delete": "none",   // 既定: "ctrl+d"
    "session_share": "none",
    "session_unshare": "none",
    "session_interrupt": "escape",   // Claude Code の Esc
    "session_background": "none",   // 既定: "ctrl+b"
    "session_compact": "none",   // 既定: "<leader>c"
    "session_toggle_timestamps": "none",
    "session_toggle_generic_tool_output": "none",
    "session_queued_prompts": "none",   // 既定: "<leader>q"
    "session_child_first": "none",   // 既定: "<leader>down"
    "session_child_cycle": "none",   // 既定: "right"
    "session_child_cycle_reverse": "none",   // 既定: "left"
    "session_parent": "none",   // 既定: "up"
    "session_pin_toggle": "none",   // 既定: "ctrl+f"
    "session_quick_switch_1": "none",   // 既定: "<leader>1"
    "session_quick_switch_2": "none",   // 既定: "<leader>2"
    "session_quick_switch_3": "none",   // 既定: "<leader>3"
    "session_quick_switch_4": "none",   // 既定: "<leader>4"
    "session_quick_switch_5": "none",   // 既定: "<leader>5"
    "session_quick_switch_6": "none",   // 既定: "<leader>6"
    "session_quick_switch_7": "none",   // 既定: "<leader>7"
    "session_quick_switch_8": "none",   // 既定: "<leader>8"
    "session_quick_switch_9": "none",   // 既定: "<leader>9"

    // stash
    "stash_delete": "none",   // 既定: "ctrl+d"

    // モデルとプロバイダ
    "model_provider_list": "none",   // 既定: "ctrl+a"
    "model_favorite_toggle": "none",   // 既定: "ctrl+f"
    "model_list": "none",   // 既定: "<leader>m"
    "model_cycle_recent": "none",   // 既定: "f2"
    "model_cycle_recent_reverse": "none",   // 既定: "shift+f2"
    "model_cycle_favorite": "none",
    "model_cycle_favorite_reverse": "none",
    "mcp_list": "none",
    "provider_connect": "none",
    "console_org_switch": "none",

    // エージェント
    "agent_list": "none",   // 既定: "<leader>a"
    "agent_cycle": "tab",   // Claude Code の shift+tab によるモード切替に相当。build / plan
    "agent_cycle_reverse": "shift+tab",   // 同上、逆順
    "variant_cycle": "none",   // 既定: "ctrl+t"
    "variant_list": "none",

    // 会話の移動と表示
    "messages_page_up": "none",   // 既定: "pageup,ctrl+alt+b"
    "messages_page_down": "none",   // 既定: "pagedown,ctrl+alt+f"
    "messages_line_up": "none",   // 既定: "ctrl+alt+y"
    "messages_line_down": "none",   // 既定: "ctrl+alt+e"
    "messages_half_page_up": "none",   // 既定: "ctrl+alt+u"
    "messages_half_page_down": "none",   // 既定: "ctrl+alt+d"
    "messages_first": "none",   // 既定: "ctrl+g,home"
    "messages_last": "none",   // 既定: "ctrl+alt+g,end"
    "messages_next": "none",
    "messages_previous": "none",
    "messages_last_user": "none",
    "messages_copy": "none",   // 既定: "<leader>y"
    "messages_undo": "none",   // 既定: "<leader>u"
    "messages_redo": "none",   // 既定: "<leader>r"
    "messages_toggle_conceal": "none",   // 既定: "<leader>h"
    "tool_details": "none",
    "display_thinking": "none",

    // プロンプト
    "prompt_submit": "none",
    "prompt_editor_context_clear": "none",
    "prompt_skills": "none",
    "prompt_stash": "none",
    "prompt_stash_pop": "none",
    "prompt_stash_list": "none",
    "workspace_set": "none",

    // 入力欄の編集 (入力欄が focus のときだけ有効)
    "input_clear": "ctrl+c",   // Claude Code の ctrl+c。空なら終了
    "input_paste": {"key": "ctrl+v", "preventDefault": false},
    "input_submit": "super+return",
    "input_newline": "return,shift+return,ctrl+return,alt+return,ctrl+j",
    "input_move_left": "left,ctrl+b",
    "input_move_right": "right,ctrl+f",
    "input_move_up": "up,ctrl+p",   // ctrl+p を上移動に追加
    "input_move_down": "down,ctrl+n",   // ctrl+n を下移動に追加
    "input_select_left": "shift+left",
    "input_select_right": "shift+right",
    "input_select_up": "shift+up",
    "input_select_down": "shift+down",
    "input_line_home": "ctrl+a",
    "input_line_end": "ctrl+e",
    "input_select_line_home": "ctrl+shift+a",
    "input_select_line_end": "ctrl+shift+e",
    "input_visual_line_home": "alt+a",
    "input_visual_line_end": "alt+e",
    "input_select_visual_line_home": "alt+shift+a",
    "input_select_visual_line_end": "alt+shift+e",
    "input_buffer_home": "home",
    "input_buffer_end": "end",
    "input_select_buffer_home": "shift+home",
    "input_select_buffer_end": "shift+end",
    "input_delete_line": "ctrl+shift+d",
    "input_delete_to_line_end": "ctrl+k",
    "input_delete_to_line_start": "ctrl+u",
    "input_backspace": "backspace,shift+backspace",
    "input_delete": "delete,shift+delete",   // ctrl+d を外して editor_open に譲った
    "input_undo": "ctrl+-,super+z",
    "input_redo": "ctrl+.,super+shift+z",
    "input_word_forward": "alt+f,alt+right,ctrl+right",
    "input_word_backward": "alt+b,alt+left,ctrl+left",
    "input_select_word_forward": "alt+shift+f,alt+shift+right",
    "input_select_word_backward": "alt+shift+b,alt+shift+left",
    "input_delete_word_forward": "alt+d,alt+delete,ctrl+delete",
    "input_delete_word_backward": "ctrl+w,ctrl+backspace,alt+backspace",
    "input_select_all": "super+a",
    "history_previous": "up,ctrl+p",   // 同上
    "history_next": "down,ctrl+n",   // 同上

    // ダイアログと補完 (それが開いている間だけ有効)
    "dialog.select.prev": "up,ctrl+p",
    "dialog.select.next": "down,ctrl+n",
    "dialog.select.page_up": "pageup",
    "dialog.select.page_down": "pagedown",
    "dialog.select.home": "home",
    "dialog.select.end": "end",
    "dialog.select.submit": "return",
    "dialog.prompt.submit": "return",
    "dialog.mcp.toggle": "space",
    "dialog.move_session.new": "ctrl+m",
    "dialog.move_session.delete": "ctrl+d",
    "dialog.move_session.refresh": "ctrl+r",
    "dialog.plugins.install": "shift+i",
    "prompt.autocomplete.prev": "up,ctrl+p",
    "prompt.autocomplete.next": "down,ctrl+n",
    "prompt.autocomplete.hide": "escape",
    "prompt.autocomplete.select": "return",
    "prompt.autocomplete.complete": "tab",
    "permission.prompt.fullscreen": "ctrl+f",
    "plugins.toggle": "space",

    // ターミナルとプラグイン
    "terminal_suspend": "ctrl+z",   // 標準の suspend
    "terminal_title_toggle": "none",
    "tips_toggle": "none",   // 既定: "<leader>h"
    "plugin_manager": "none",
    "plugin_install": "none",

    // which-key
    "which_key_toggle": "ctrl+alt+k",   // 現在有効なキーの確認用
    "which_key_layout_toggle": "none",   // 既定: "ctrl+alt+shift+k"
    "which_key_pending_toggle": "none",   // 既定: "ctrl+alt+shift+p"
    "which_key_group_previous": "none",   // 既定: "ctrl+alt+left,ctrl+alt+["
    "which_key_group_next": "none",   // 既定: "ctrl+alt+right,ctrl+alt+]"
    "which_key_scroll_up": "none",   // 既定: "ctrl+alt+up,ctrl+alt+p"
    "which_key_scroll_down": "none",   // 既定: "ctrl+alt+down,ctrl+alt+n"
    "which_key_page_up": "none",   // 既定: "ctrl+alt+pageup"
    "which_key_page_down": "none",   // 既定: "ctrl+alt+pagedown"
    "which_key_home": "none",   // 既定: "ctrl+alt+home"
    "which_key_end": "none"   // 既定: "ctrl+alt+end"
  }
}
