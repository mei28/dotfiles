;; kanata config — Home Row Mods (bilateral)
;; - 同手キーは tap、反対手キー押下時のみ hold で修飾発火
;; - tap-hold-release-keys: 反対手キーが押されて離されたら早期 hold

(defcfg
  process-unmapped-keys no
  concurrent-tap-hold yes
  macos-dev-names-include ("Apple Internal Keyboard / Trackpad")
)

(defsrc
  q    w    e    r    t    y    u    i    o    p
  a    s    d    f    g    h    j    k    l    ;
  z    x    c    v    b    n    m    ,    .    /
  fn   f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12
)

(defvar
  ;; tap-hold の第1引数は kanata 公式ドキュメントで $tap-repress-timeout と呼ばれる。
  ;; タップ後この時間内に同じキーを押し直すと、tap/hold の判定をせず文字を押しっぱなしにする
  ;; (キーリピート用の仕様)。vim の j/k 長押しスクロールはこの経路で動いているので、
  ;; 下げるとスクロールが壊れる。macOS 側の InitialKeyRepeat と対で調整すること
  ;; (.config/nix/nix-darwin/config/system/keyboard.nix)。
  tap-repress-time 200
  hold-time 250

  left-hand-keys (
    q w e r t
    a s d f g
    z x c v b
  )
  right-hand-keys (
    y u i o p
    h j k l ;
    n m , . /
  )
)

(defalias
  ;; 左手 mods
  s_sft (tap-hold-release-keys $tap-repress-time $hold-time s lsft $right-hand-keys)
  d_alt (tap-hold-release-keys $tap-repress-time $hold-time d lalt $right-hand-keys)
  f_ctl (tap-hold-release-keys $tap-repress-time $hold-time f lctl $right-hand-keys)
  e_cmd (tap-hold-release-keys $tap-repress-time $hold-time e lmet $right-hand-keys)

  ;; 右手 mods
  j_ctl (tap-hold-release-keys $tap-repress-time $hold-time j rctl $left-hand-keys)
  k_alt (tap-hold-release-keys $tap-repress-time $hold-time k lalt $left-hand-keys)
  l_sft (tap-hold-release-keys $tap-repress-time $hold-time l lsft $left-hand-keys)
  i_cmd (tap-hold-release-keys $tap-repress-time $hold-time i rmet $left-hand-keys)

  ;; fn 押下中は fkeys レイヤー (F1-F12 を生 F キーとして送出)
  fnh (layer-while-held fkeys)
)

(deflayer base
  q       w       @e_cmd  r       t       y       u       @i_cmd  o       p
  a       @s_sft  @d_alt  @f_ctl  g       h       @j_ctl  @k_alt  @l_sft  ;
  z       x       c       v       b       n       m       ,       .       /
  @fnh    brdn    brup    mctl    lpad    bldn    blup    prev    pp      next    mute    vold    volu
)

;; HRM 無効、生 QWERTY (layer-switch で切替)
(deflayer nomod
  q       w       e       r       t       y       u       i       o       p
  a       s       d       f       g       h       j       k       l       ;
  z       x       c       v       b       n       m       ,       .       /
  @fnh    brdn    brup    mctl    lpad    bldn    blup    prev    pp      next    mute    vold    volu
)

;; fn 押下中: F1-F12 を生 F キーとして送出 (macOS デフォルト挙動)
(deflayer fkeys
  _       _       _       _       _       _       _       _       _       _
  _       _       _       _       _       _       _       _       _       _
  _       _       _       _       _       _       _       _       _       _
  _       f1      f2      f3      f4      f5      f6      f7      f8      f9      f10     f11     f12
)
